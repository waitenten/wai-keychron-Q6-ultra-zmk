#include <dt-bindings/zmk/keychron.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;

            tap-ms = <20>;
        };

        mouse_encoder: mouse_encoder {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&mkp>, <&mkp>;

            tap-ms = <20>;
        };

        // ==========================================================
        // ここから下は Keychron 標準ファームウェアには存在しない追記です。
        // 目的: ANSI物理配列のキーボードを、OS側の設定を「日本語キーボード」
        // (JIS 106/109) のままにして使う際の、記号キーの表示ズレを補正する。
        // 参考にした一次情報:
        //  - sekigon-gonnoc氏 Keyboard Quantizer の os_key_override (QMK Key Override)
        //  - kloir-z氏「ZMK OS設定を日本語キーボードのまま使う」(note.com)
        //  - Keychron B1 Pro ZMKでの実装例(緑茶緑々氏, note.com)
        // 各キーコード名(AT, CARET, INT3 等)はZMK本体 keys.h で定義済みの
        // 標準エイリアスのみを使用しており、独自の#defineは行っていない。
        // ==========================================================
        // ` (無変換) / ~ (Shift)

        jis_grave: jis_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_GRAVE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp PLUS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 2 (無変換) / @ (Shift)

        jis_n2: jis_n2 {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_N2";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LEFT_BRACKET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 6 (無変換) / ^ (Shift)

        jis_n6: jis_n6 {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_N6";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp EQUAL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 7 (無変換) / & (Shift)

        jis_n7: jis_n7 {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_N7";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp CARET>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 8 (無変換) / * (Shift)

        jis_n8: jis_n8 {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_N8";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp SINGLE_QUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 9 (無変換) / ( (Shift)

        jis_n9: jis_n9 {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_N9";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp ASTERISK>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 0 (無変換) / ) (Shift)

        jis_n0: jis_n0 {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_N0";
            #binding-cells = <0>;
            bindings = <&kp N0>, <&kp LEFT_PARENTHESIS>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // - (無変換) / _ (Shift)

        jis_minus: jis_minus {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_MINUS";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(INT1)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // = (無変換) / + (Shift)

        jis_equal: jis_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_EQUAL";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&kp COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // [ (無変換) / { (Shift)

        jis_lbkt: jis_lbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_LBKT";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ] (無変換) / } (Shift)

        jis_rbkt: jis_rbkt {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_RBKT";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // \ (無変換、¥として表示) / | (Shift)

        jis_bslh: jis_bslh {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_BSLH";
            #binding-cells = <0>;
            bindings = <&kp INT3>, <&kp LS(INT3)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ; (無変換) / : (Shift)

        jis_semi: jis_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_SEMI";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp SINGLE_QUOTE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ' (無変換) / " (Shift)

        jis_sqt: jis_sqt {
            compatible = "zmk,behavior-mod-morph";
            label = "JIS_SQT";
            #binding-cells = <0>;
            bindings = <&kp AMPERSAND>, <&kp AT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        to0: to0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TO0";
            #binding-cells = <0>;
            bindings = <&none>, <&none>, <&to 0>;
        };

        enjp: enjp {
            compatible = "zmk,behavior-tap-dance";
            label = "ENJP";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2>, <&kp LANG4>;
        };
    };

    macro1: zm_ma {
        compatible = "zmk,behavior-macro-one-param";
        #binding-cells = <1>;
        bindings = <&kp 0x770000>;
    };

    siri: siri {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&macro_tap_time 500>, <&uc LG(SPACE)>;
    };

    lm: layer_mod {
        compatible = "zmk,behavior-macro-two-param";
        wait-ms = <0>;
        tap-ms = <0>;
        #binding-cells = <2>;
        bindings =
            <&macro_param_1to1>,
            <&macro_press>,
            <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
            <&macro_press>,
            <&kp MACRO_PLACEHOLDER>,
            <&macro_pause_for_release>,
            <&macro_param_2to1>,
            <&macro_release>,
            <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
            <&macro_release>,
            <&mo MACRO_PLACEHOLDER>;
    };

    td1: tapd_layer {
        compatible = "zmk,behavior-tap-dance1";
        #binding-cells = <1>;
        tapping-term-ms = <350>;
        bindings = <&mo 0>, <&mo 0>, <&mo 0>, <&mo 0>, <&to 0>;
    };

    kc_lp: l1 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&kc>, <&none>;
    };

    long_press_bootloader: lp_bootloader {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bootloader>, <&none>;
    };

    // kc_nkro:kc_nkro{
    //     compatible = "zmk,behavior-hold-tap";
    //     #binding-cells = <2>;
    //     flavor = "tap-preferred";
    //     tapping-term-ms = <2000>;  // delay amount in ms
    //     bindings = <&kc NKRO>, <&none>;
    // };

    ZMK_MACRO(bt_pair0,

    bindings = <&kc BT_PAIR 0>;

    )
    ZMK_MACRO(

    bt_pair1,
    bindings = <&kc BT_PAIR 1>;

    )
    ZMK_MACRO(

    bt_pair2,
    bindings = <&kc BT_PAIR 2>;

    )
    ZMK_MACRO(

    ppt_pair,
    bindings = <&kc PPT_PAIR 0>;

    )
    ZMK_MACRO(

    bt_recon_0,
    bindings = <&kc BT_SEL 0>;

    )
    ZMK_MACRO(

    bt_recon_1,
    bindings = <&kc BT_SEL 1>;

    )
    ZMK_MACRO(

    bt_recon_2,
    bindings = <&kc BT_SEL 2>;

    )
    ZMK_MACRO(

    ppt_recon,
    bindings = <&kc PPT_SEL 0>;

    )

    bt_pair_0: bt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair0>, <&bt_recon_0>;
    };

    bt_pair_1: bt_pair_1 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair1>, <&bt_recon_1>;
    };

    bt_pair_2: bt_pair_2 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&bt_pair2>, <&bt_recon_2>;
    };

    ppt_pair_0: ppt_pair_0 {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <3000>;  // delay amount in ms
        bindings = <&ppt_pair>, <&ppt_recon>;
    };

    uc: user_custom {
        compatible = "zmk,behavior-key-press";
        #binding-cells = <1>;
    };

    combos {
        compatible = "zmk,combos";

        combo_a {
            timeout-ms = <400>;
            layers = < 1 3>;
            key-positions = <69 80>; //fn+j+z
            bindings = <&kc_lp RCV>;
        };

        // combo_b {v
        //         timeout-ms = <1000>;
        //         layers =< 1 3>;
        //         key-positions = <64>; //fn+b
        //         bindings = <&kc BATINFO>;
        // };
        // combo_c {
        //         timeout-ms = <1000>;
        //         layers =< 1 3>;
        //         key-positions = <58 81>; //fn+home+right
        //         bindings = <&kc_lp RGBTEST>;
        // };

        combo_t0 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&to 3 >;
        };

        combo_t1 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&tog 3 >;
        };

        combo_t2 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&sl 3 >;
        };

        combo_t3 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&lt 3 SPACE>;
        };

        combo_t4 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&sk LSHIFT>;
        };

        combo_t5 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&mt LSHIFT SPACE>;
        };

        combo_t6 {
            timeout-ms = <10 >;
            layers = <4>;
            key-positions = <120>;
            bindings = <&gresc>;
        };

        //  combo_t7 {
        //     timeout-ms = <10 >;
        //     layers =<4>;
        //     key-positions = <120>;
        //     bindings = <&mkp 0>;
        // };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        //mac
        // ※ Macを使用しないため、Winレイヤー(layer_two)と完全に同一の内容にしています。
        //   (2026-07-XX 変更。元のMac用内容はlayer_oneと共にKeychronオリジナルのまま残っています)

        default_layer {
            bindings = <
&kp ESC               &kp F1    &kp F2    &kp F3     &kp F4    &kp F5    &kp F6     &kp F7   &kp F8     &kp F9    &kp F10     &kp F11     &kp F12          &kp C_MUTE    &kp PRINTSCREEN  &uc LG(C)  &rgb_ug RGB_EFF  &kp F13         &kp F14       &kp F15          &kp F16
&enjp                 &kp N1    &jis_n2   &kp N3     &kp N4    &kp N5    &jis_n6    &jis_n7  &jis_n8    &jis_n9   &jis_n0     &jis_semi   &jis_sqt         &kp BSPC      &kp INS          &kp HOME   &kp PAGE_UP      &kp KP_NUMLOCK  &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_MINUS
&kp TAB               &kp Q     &kp W     &kp E      &kp R     &kp T     &kp Y      &kp U    &kp I      &kp O     &kp P       &jis_lbkt   &jis_rbkt        &jis_bslh     &kp DEL          &kp END    &kp PAGE_DOWN    &kp KP_N7       &kp KP_N8     &kp KP_N9
&mt INT_HENKAN LCTRL  &kp A     &kp S     &kp D      &kp F     &kp G     &kp H      &kp J    &kp K      &kp L     &jis_minus  &jis_equal  &mt RCTRL ENTER  &kp KP_N4     &kp KP_N5        &kp KP_N6  &kp KP_PLUS
&kp LSHFT             &kp Z     &kp X     &kp C      &kp V     &kp B     &kp N      &kp M    &kp COMMA  &kp DOT   &kp FSLH    &kp RSHFT   &kp UP           &kp KP_N1     &kp KP_N2        &kp KP_N3
&kp LCTRL             &kp LGUI  &kp LALT  &kp SPACE  &kp RALT  &kp RGUI  &kp RCTRL  &mo 3    &kp LEFT   &kp DOWN  &kp RIGHT   &kp KP_N0   &kp KP_DOT       &kp KP_ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        //mac fn layer

        layer_one {
            bindings = <
&none           &none   &none   &none          &none   &none   &none   &none   &none   &none   &none   &none   &none   &none   &none  &none  &none   &none  &none  &none  &none
&none           &none   &none   &none          &none   &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none           &none   &none   &none          &none   &none   &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp CLCK        &none   &none   &none          &none   &none   &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp LEFT_SHIFT  &none  &none  &none         &none  &none   &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none          &none  &none  &kp BACKSPACE  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;

            sensor-bindings = <&rgb_encoder>;
        };

        //win
        // ※ 数字行・記号キーの一部は、OS側キーボード設定が「日本語」の場合に
        //   ANSIキーキャップの見た目通りの文字が入力されるよう、
        //   上記 jis_* ビヘイビア(追記分)に置き換えています。

        layer_two {
            bindings = <
&kp ESC     &kp F1    &kp F2    &kp F3     &kp F4    &kp F5    &kp F6             &kp F7   &kp F8     &kp F9    &kp F10    &kp F11     &kp F12     &kp C_MUTE    &kp PRINTSCREEN  &uc LG(C)  &rgb_ug RGB_EFF  &kp F13         &kp F14       &kp F15          &kp F16
&jis_grave  &kp N1    &jis_n2   &kp N3     &kp N4    &kp N5    &jis_n6            &jis_n7  &jis_n8    &jis_n9   &jis_n0    &jis_minus  &jis_equal  &kp BSPC      &kp INS          &kp HOME   &kp PAGE_UP      &kp KP_NUMLOCK  &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_MINUS
&kp TAB     &kp Q     &kp W     &kp E      &kp R     &kp T     &kp Y              &kp U    &kp I      &kp O     &kp P      &jis_lbkt   &jis_rbkt   &jis_bslh     &kp DEL          &kp END    &kp PAGE_DOWN    &kp KP_N7       &kp KP_N8     &kp KP_N9
&kp CLCK    &kp A     &kp S     &kp D      &kp F     &kp G     &kp H              &kp J    &kp K      &kp L     &jis_semi  &jis_sqt    &kp RET     &kp KP_N4     &kp KP_N5        &kp KP_N6  &kp KP_PLUS
&kp LSHFT   &kp Z     &kp X     &kp C      &kp V     &kp B     &kp N              &kp M    &kp COMMA  &kp DOT   &kp FSLH   &kp RSHFT   &kp UP      &kp KP_N1     &kp KP_N2        &kp KP_N3
&kp LCTRL   &kp LGUI  &kp LALT  &kp SPACE  &kp RALT  &kp RGUI  &kp RIGHT_CONTROL  &to0     &kp LEFT   &kp DOWN  &kp RIGHT  &kp KP_N0   &kp KP_DOT  &kp KP_ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        //win fn layer

        layer_three {
            bindings = <
&none           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &uc LG(TAB)      &uc LG(E)        &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &rgb_ug RGB_TOG  &none  &none  &rgb_ug RGB_TOG  &none  &none  &none  &none
&none           &bt_pair_0 0 0        &bt_pair_1 0 0        &bt_pair_2 0 0   &ppt_pair_0 0 0  &none           &none           &none          &none            &none      &none      &none             &none           &none           &none  &none  &none           &none  &none  &none  &none
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF       &rgb_ug RGB_BRI       &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &none           &none          &none            &none      &none      &none             &none           &none           &none  &none  &none           &none  &none  &none
&none           &rgb_ug RGB_EFR       &rgb_ug RGB_BRD       &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &none           &none          &none            &none      &none      &none             &none           &none           &none  &none  &none
&none           &none                &none                &none           &none           &kc BATINFO      &none           &none          &none            &none      &none      &none             &none           &none           &none  &none
&none           &none                &none                &none           &none           &none           &none           &none          &none            &none      &none      &none             &none           &none
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};

&mt { tapping-term-ms = <400>; };

&inc_dec_kp { tap-ms = <20>; };
